<div class="container-fluid">
  <% messages.each do |message| %>
    <% if message.content.is_a? String %>
      <div class="<%= message.html_classes %>" role="alert">
        <%= message.content %>
        <a class="btn-close float-end" data-bs-dismiss="alert" href="#"></a>
      </div>
    <% end %>
  <% end %>
</div>
