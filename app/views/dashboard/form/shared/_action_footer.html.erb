<% primary_action = local_assigns.fetch(:primary_action, :save_and_continue) %>
<% secondary_action = current_user.admin? ? :admin_save : param_key %>

<div class="footer footer--actions footer--fixed d-flex justify-content-center">
  <div>
    <% if primary_action == :publish %>
      <%= render 'dashboard/form/publish/actions', form: form %>
    <% else %>
      <%= form.submit t("dashboard.form.actions.#{primary_action}.button"), name: primary_action, data: { bs_toggle: 'tooltip', placement: 'top', title: t("dashboard.form.actions.#{primary_action}.tooltip") }, class: 'btn btn-primary btn--rounded' %>
    <% end %>
    <%= link_to t('dashboard.form.actions.cancel.button'), cancel_path, data: { bs_toggle: 'tooltip', placement: 'top', title: t('dashboard.form.actions.cancel.tooltip') }, class: 'btn btn-outline-dark btn--rounded ms-2' %>
  </div>
  <%= form.button t("dashboard.form.actions.save_and_exit.#{secondary_action}"), name: 'save_and_exit', data: { bs_toggle: 'tooltip', placement: 'top', title: t('dashboard.form.actions.save_and_exit.tooltip') }, class: 'btn btn-outline-primary btn--rounded pull-left' %>

  <% if form.object.persisted? && policy(form.object).destroy? %>
    <%= render DeleteResourceButtonComponent.new(
          resource: form.object,
          html_class: 'btn btn-outline-danger btn--rounded pull-right',
          hide_if_published: true
        ) %>
  <% end %>
</div>
