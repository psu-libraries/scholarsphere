#!/bin/bash
set -e

# Preserve any Postgres connection vars already injected directly onto the
# container (e.g. Crossplane's per-instance connection secret via envFrom) so
# that sourcing the shared Vault secret below doesn't silently overwrite them
# with its generic fallback credentials.
_pg_host="$POSTGRES_HOST"
_pg_db="$POSTGRES_DB"
_pg_user="$POSTGRES_USER"
_pg_password="$POSTGRES_PASSWORD"

if [ -f /vault/secrets/config ]; then
  . /vault/secrets/config
fi

[ -n "$_pg_host" ] && POSTGRES_HOST="$_pg_host"
[ -n "$_pg_db" ] && POSTGRES_DB="$_pg_db"
[ -n "$_pg_user" ] && POSTGRES_USER="$_pg_user"
[ -n "$_pg_password" ] && POSTGRES_PASSWORD="$_pg_password"
export POSTGRES_HOST POSTGRES_DB POSTGRES_USER POSTGRES_PASSWORD

if [ "${RAILS_ENV:-development}" != "production" ]; then
  bundle check || bundle
  echo "Initalizing the database and solr"
  bundle exec rails solr:init
  bundle exec rails db:create db:migrate
  bundle exec rails db:seed:groups
fi

echo "starting rails"
rm -f tmp/pids/server.pid

exec bundle exec rails s -b '0.0.0.0'
