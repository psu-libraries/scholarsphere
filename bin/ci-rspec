#!/bin/bash
# ci-rspec
#
# Runs the rspec test suite in our CI environment using Code Climate to send coverage reporting data.
#
set -e

# Local variables
REPORTER_BIN="cc-test-reporter"

# Make sure we have a database and migrations
bundle exec rails db:create
bundle exec rails db:migrate
echo "Waiting for Solr to become available"
if ! timeout 60 bash -c 'until printf "" 2>>/dev/null >>/dev/tcp/$0/$1; do sleep 1; done' "${SOLR_HOST:-localhost}" "${SOLR_PORT:-8983}"
then
  echo "Solr never became ready. Exiting"
  exit 1
fi

# Sometimes, if we do a good enough job of caching the docker build, rspec will start running before the database is ready
echo "Waiting for Postgres to become available"
if ! timeout 60 bash -c 'until printf "" 2>>/dev/null >>/dev/tcp/$0/$1; do sleep 1; done' "${POSTGRES_HOST:-localhost}" "${POSTGRES_PORT:-5432}"
then
  echo "Postgres never became ready. Exiting"
  exit 1
fi

echo "Initializing Solr"
# Retry solr:init up to 36 times (180 seconds total) because ZooKeeper needs time to initialize
for i in {1..36}; do
  if bundle exec rake solr:init 2>&1; then
    echo "Solr initialized successfully"
    sleep 10  # Give Solr time to stabilize after initialization
    break
  fi
  if [ $i -lt 36 ]; then
    echo "Solr not ready yet, retrying in 5 seconds... (attempt $i/36)"
    sleep 5
  else
    echo "Failed to initialize Solr after 36 attempts"
    exit 1
  fi
done

# Verify Solr is actually responding to HTTP requests AND can perform operations
echo "Waiting for Solr to respond and stabilize..."
SOLR_READY=0
CONSECUTIVE_SUCCESS=0
for i in {1..120}; do
  # Test both LIST (read) and UPDATE (write) operations
  if curl -fsS -u scholarsphere:scholarsphere "http://${SOLR_HOST:-127.0.0.1}:${SOLR_PORT:-8983}/solr/admin/collections?action=LIST&wt=json" > /dev/null 2>&1 && \
     curl -fsS -u scholarsphere:scholarsphere -X POST -H "Content-Type: application/json" \
       -d '{"delete":{"query":"id:solr-health-check-*"}}' \
       "http://${SOLR_HOST:-127.0.0.1}:${SOLR_PORT:-8983}/solr/scholarsphere/update?wt=json&commit=true" > /dev/null 2>&1; then
    CONSECUTIVE_SUCCESS=$((CONSECUTIVE_SUCCESS + 1))
    if [ $CONSECUTIVE_SUCCESS -ge 5 ]; then
      echo "Solr is ready for operations (5 consecutive successful responses)"
      SOLR_READY=1
      break
    fi
    echo "  Solr responding... ($CONSECUTIVE_SUCCESS/5 consecutive successes, attempt $i/120)"
  else
    CONSECUTIVE_SUCCESS=0
    echo "  Waiting for Solr to stabilize... (attempt $i/120)"
  fi
  sleep 1
done

if [ $SOLR_READY -eq 0 ]; then
  echo "ERROR: Solr did not stabilize within 120 seconds"
  exit 1
fi

# Final stabilization wait
echo "Solr fully initialized, waiting for final stabilization..."
sleep 10

# If there's no Git repo, then assume this is DroneCI's environment
# and link variables to the ones that Code Climate expects.
# Note: GIT_COMMITTED_AT is a guess since this isn't a real git repo. We don't know what kinds of effects this may have
# on how Code Climate does its thing.
if [ ! -d ".git" ]; then
  GIT_COMMIT_SHA=$CIRCLE_SHA1
  export GIT_COMMIT_SHA
  GIT_BRANCH=$CIRCLE_BRANCH
  export GIT_BRANCH
fi

#if [ ! -f ${REPORTER_BIN} ]; then
#  echo "Downloading Code Climate reporting tool"
#  if [[ `uname` == *"Darwin"* ]]; then
#    wget -q https://codeclimate.com/downloads/test-reporter/test-reporter-latest-darwin-amd64 -O ${REPORTER_BIN}
#  else
#    wget -q https://codeclimate.com/downloads/test-reporter/test-reporter-latest-linux-amd64 -O ${REPORTER_BIN}
#  fi
#  chmod 755 ${REPORTER_BIN}
#fi

echo "Running RSpec with coverage reporting"
# ./${REPORTER_BIN} before-build
bundle exec rspec "$@"
RSPEC_EXIT_CODE=$?
# ./${REPORTER_BIN} after-build

exit ${RSPEC_EXIT_CODE}
